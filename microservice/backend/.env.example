# ===================================================================
# Khandua Looms Microservices — Environment Template (.env.example)
# Copy this file to .env.dev (for Docker Compose) or .env.local (for local host run)
# ===================================================================

# Platform & Runtime Environment
ENVIRONMENT=development

# Database Credentials & URL (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=khandualoom_db
POSTGRES_HOST_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/khandualoom_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis & Kafka Broker Coordinates
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Microservice Discovery & Gateway URLs
API_GATEWAY_HOST_PORT=8080
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
ORDER_SERVICE_URL=http://localhost:8085
PAYMENT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087
AUDIT_SERVICE_URL=http://localhost:8088

# JWT Security Signature Secret (Minimum 256-bit HMAC key)
JWT_SECRET=your-256-bit-jwt-secret-key-min-32-bytes-abcdef1234567890

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Email & SMTP Gateway (Brevo / Sendinblue)
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=concierge@khandualoom.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587

# OAuth 2.0 Identity Provider Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Observability (OpenTelemetry OTLP Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
