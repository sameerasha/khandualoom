# ===================================================================
# Khandua Looms Microservices — Environment Template (.env.example)
# Copy this file to .env.dev (for Docker Compose) or .env.local (for local run)
# ===================================================================

# Database Credentials & URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=khandualoom_db
DB_URL=jdbc:postgresql://localhost:5419/khandualoom_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis & Kafka Broker Coordinates
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Microservice Discovery & Gateway URLs
AUTH_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# JWT Security Signature Secret (Minimum 256-bit HMAC key)
JWT_SECRET=your-256-bit-jwt-secret-key-here

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Email & SMTP Gateway (Brevo / Sendinblue)
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=concierge@khandualoom.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587

# OAuth 2.0 Identity Provider Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Observability (OpenTelemetry OTLP Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
